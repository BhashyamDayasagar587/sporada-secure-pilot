# Per-box pilot configuration. Copy to deploy/.env and edit. Host paths.

# Where your source videos live. cameras.json source.uri values are RELATIVE to
# this dir (e.g. "20/20E.mp4"), so the same camera config works on any box.
VIDEO_DIR=/srv/alpr/videos

# Voyager SDK venv that has axelera-runtime + openvino installed (host worker).
VOYAGER_VENV=/opt/voyager-sdk/venv

# Compiled models (committed in-repo under ./models; rarely changed).
MODELS_DIR=/srv/alpr/traffic-pilot/models

# Optional Redis auth (leave empty for the pilot).
REDIS_PASSWORD=
