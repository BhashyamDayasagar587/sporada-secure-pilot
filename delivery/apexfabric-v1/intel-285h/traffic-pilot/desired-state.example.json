        "line": {
          "name": "gate_line",
          "a": [0.15, 0.55],
          "b": [0.85, 0.55],
          "direction": "both"
        }
      }
    },
    {
      "camera_id": "smoke-and-plate-zone",
      "source": "file:/run/secrets/apexfabric/smoke-and-plate-zone.rtsp",
      "fps": 5,
      "apps": ["fire_smoke_detection", "plate_detection"],
      "config": {
        "zone": {
          "name": "active_area",
          "poly": [[0.05, 0.05], [0.95, 0.05], [0.95, 0.95], [0.05, 0.95]]
        }
      }
    }
  ]
